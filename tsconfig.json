{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "tests", "build", "vite.config.ts"],
  "exclude": ["src/broadcast/dom", "src/listen/dom", "src/offline/dom", "src/offline/worker/sw-entry.ts", "tests/offline/register.test.ts"]
}
