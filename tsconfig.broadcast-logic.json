{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/broadcast", "src/languages", "src/shared", "src/message-code", "src/sound-link"],
  "exclude": ["src/broadcast/dom", "src/languages/dom", "src/shared/ui/dom"]
}
