{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "src/front",
    "src/languages",
    "src/shared",
    "src/offline",
    "src/message-code",
    "src/sound-link",
    "src/broadcast/strings.types.ts",
    "src/broadcast/strings.en.ts",
    "src/broadcast/build.ts",
    "src/broadcast/broadcast-run.ts",
    "src/broadcast/dom/web-audio.ts"
  ],
  "exclude": ["src/offline/worker/sw-entry.ts"]
}
